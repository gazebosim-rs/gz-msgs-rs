+    /// Decode one file with the Gazebo Linux LP64 integer-default policy.
+    ///
+    /// Eligible nonrepeated proto2 integer fields use the compatibility parser;
+    /// oneof fields must be optional. Raw default spellings, extensions, proto3
+    /// defaults and other scalar kinds are unchanged.
+    /// This is an opt-in loader boundary, not general native descriptor validation.
+    pub fn decode_file_descriptor_proto_with_integer_defaults<B>(
+        &mut self,
+        bytes: B,
+    ) -> Result<(), DescriptorError>
+    where
+        B: Buf,
+    {
+        let file = types::FileDescriptorProto::decode(bytes).map_err(|err| {
+            DescriptorError::new(vec![DescriptorErrorKind::DecodeFileDescriptorSet { err }])
+        })?;
+        self.build_files_with_integer_defaults(iter::once(file), true)
+    }
