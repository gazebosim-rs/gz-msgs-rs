+    fn is_default_value(&self, default: Self) -> bool {
+        match (self, default) {
+            (Self::F32(value), Self::F32(default)) => value.to_bits() == default.to_bits(),
+            (Self::F64(value), Self::F64(default)) => value.to_bits() == default.to_bits(),
+            (_, default) => *self == default,
+        }
+    }
